# Bundle generato da build.py (rigenerabile da template + data + vendor + brand)
dist/
# Rete pedonale da OSM (~19 MB): si rifa' con prepara_rete_pedonale.py
data/rete/
# Rete per la bici (~19 MB): si rifa' con prepara_rete_bici.py
data/rete-bici/
# Estratti OSM e indirizzi grezzi: input dei prepara_*.py, non si versionano
*.pbf
civici_*.csv
# Fonti grezze delle antenne (pagine, PDF, civici): si riscaricano con prepara_antenne.py --scarica
fonti-antenne/
# Locali
__pycache__/
.pytest_cache/
.DS_Store
node_modules/
.env
.vercel/
# Il pattern "Icon?" (stub di macOS) con core.ignorecase prende anche icone/: la si riammette
!icone/
!icone/**
